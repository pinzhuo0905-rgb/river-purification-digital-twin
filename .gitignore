# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local
*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Backend Virtual Environments
.venv/
.venv*/
backend/.venv/
backend/.venv311/
backend/.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
*.so

# Databases & Local Data
*.db
*.sqlite3
backend/*.db
river_scenarios.db

# Logs
logs/
*.log

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
__MACOSX/

# Editor & IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent & AI Tool Local Worktrees/Caches
.worktrees/
.superpowers/
.claude/
.antigravity/
temp_skill/
